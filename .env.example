# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git, so your keys are never uploaded.

# Google Gemini (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional: models to try in order
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
